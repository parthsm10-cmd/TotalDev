@model List<TotalDev.Models.Order_HDR>

@{
    ViewData["Title"] = "Customer Home";
    Layout = "~/Views/Shared/_Layout.cshtml";

    DateTime selectedDate = ViewBag.SelectedDate != null
        ? (DateTime)ViewBag.SelectedDate
        : DateTime.Today;

    decimal totalAmount = Model?.Sum(x => x.TotalAmount) ?? 0;
    decimal totalQty = Model?.Sum(x => x.TotalQty) ?? 0;
}

<div class="container-fluid py-4">

    <!-- Welcome Banner -->
    <div class="p-4 p-md-5 rounded-4 text-white shadow-sm"
         style="background:linear-gradient(135deg,#14532D,#16A34A);">

        <h2 class="fw-bold mb-2">
            Welcome, @ViewBag.CustomerName!
        </h2>

        <p class="mb-0">
            Welcome to Patel Dairy Customer Portal.
            Manage your dairy orders easily.
        </p>
    </div>

    <!-- Create Order -->
    @* <div class="row g-3 mt-3">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle p-3 me-3"
                             style="background:#dcfce7;color:#166534;">
                            <i class="bi bi-cart-plus fs-3"></i>
                        </div>

                        <h5 class="fw-bold mb-0">Create Order</h5>
                    </div>

                    <p class="text-muted">
                        Select your dairy products and place a new order.
                    </p>

                    

                </div>
            </div>
        </div>

    </div> *@

    <!-- Order Summary -->
    <div class="row g-3 mt-2">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="text-muted mb-2">Total Orders</div>
                    <h3 class="fw-bold text-success">
                        @(Model?.Count ?? 0)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="text-muted mb-2">Total Order Amount</div>
                    <h3 class="fw-bold text-success">
                        ₹ @totalAmount.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Date Wise Orders -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-white border-0 p-4">

            <h5 class="fw-bold mb-1">
                <i class="bi bi-calendar-check text-success me-2"></i>
                My Orders
            </h5>

            <small class="text-muted">
                View your orders by date.
            </small>
            <a asp-controller="Order_HDR" asp-action="Index" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i>
                Create Order
            </a>
        </div>

        <div class="card-body p-4">

            <!-- Date Filter -->
            <form asp-controller="Customer"
                  asp-action="CustomerHome"
                  method="get">

                <div class="row g-3 align-items-end mb-4">

                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Select Order Date
                        </label>

                        @* <input type="date"
                               name="selectedDate"
                               value="@selectedDate.ToString("yyyy-MM-dd")"
                               class="form-control" /> *@
                        <input type="text"
                               id="selectedDate"
                               name="selectedDate"
                               value="@selectedDate.ToString("dd-MM-yyyy")"
                               class="form-control"
                               placeholder="dd-MM-yyyy" />

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-success w-100">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>

                    </div>

                    <div class="col-md-2">

                        <a asp-controller="Customer"
                           asp-action="CustomerHome"
                           class="btn btn-outline-secondary w-100">
                            <i class="bi bi-calendar-day me-1"></i>
                            Today
                        </a>

                    </div>

                </div>

            </form>

            <!-- Selected Date -->
            <div class="mb-3">
                <span class="text-muted">
                    Orders for:
                </span>

                <strong>
                    @selectedDate.ToString("dd-MM-yyyy")
                </strong>
            </div>

            <!-- Orders Table -->
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Sr. No.</th>
                            <th>Order No.</th>
                            <th>Order Date</th>
                            <th class="text-end">Total Qty</th>
                            <th class="text-end">Total Amount</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int sr = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@sr</td>

                                    <td class="fw-semibold">
                                        @item.Ord_No
                                    </td>

                                    <td>
                                        @item.Ord_Date.ToString("dd-MM-yyyy")
                                    </td>

                                    <td class="text-end">
                                        @item.TotalQty.ToString("N2")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        ₹ @item.TotalAmount.ToString("N2")
                                    </td>
                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center py-5">

                                    <i class="bi bi-inbox fs-1 text-muted"></i>

                                    <h6 class="text-muted mt-2">
                                        No Orders Found
                                    </h6>

                                    <p class="text-muted mb-0">
                                        You don't have any orders on
                                        @selectedDate.ToString("dd-MM-yyyy").
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                    @if (Model != null && Model.Any())
                    {
                        <tfoot class="table-light">

                            <tr>
                                <th colspan="3" class="text-end">
                                    Total:
                                </th>

                                <th class="text-end">
                                    @totalQty.ToString("N2")
                                </th>

                                <th class="text-end">
                                    ₹ @totalAmount.ToString("N2")
                                </th>
                            </tr>

                        </tfoot>
                    }

                </table>

            </div>

        </div>
    </div>

</div>
@section Scripts {
    
    <script>
        flatpickr("#selectedDate", {
            dateFormat: "d-m-Y",
            allowInput: true
        });
    </script>
}