
@{
    ViewData["Title"] = "Customer Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="p-4 p-md-5 rounded-4"
         style="background: linear-gradient(135deg, #14532D, #16A34A); color: white;">

        <h1 class="fw-bold mb-2">
            Welcome, @Context.Session.GetString("UserName")!
        </h1>

        <p class="mb-0">
            Welcome to Patel Dairy Customer Portal.
            Manage your dairy orders easily.
        </p>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Create Order</h5>
                    <p class="text-muted">
                        Select your dairy products and place a new order.
                    </p>
                    <a asp-controller="Order_HDR"
                       asp-action="Index"
                       class="btn btn-success">
                        Create Order
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
