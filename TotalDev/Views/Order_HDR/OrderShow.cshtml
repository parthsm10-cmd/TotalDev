
@model TotalDev.Models.OrderShowViewModel

@{
    ViewData["Title"] = "Date Wise Order Report";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Date Wise Order Report</h3>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    </div>

    <!-- Date Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-controller="Order_HDR"
                  asp-action="OrderShow"
                  method="get">

                <div class="row align-items-end">

                    <div class="col-md-3">
                        <label class="form-label">From Date</label>
                        <input type="date"
                               name="fromDate"
                               class="form-control"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">To Date</label>
                        <input type="date"
                               name="toDate"
                               class="form-control"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Show Report
                        </button>
                    </div>

                    <div class="col-md-4">
                        <a asp-controller="Order_HDR"
                           asp-action="DownloadOrderShowPdf"
                           asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                           asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
                           class="btn btn-danger w-100">

                            <i class="bi bi-file-earmark-pdf"></i>
                            Download PDF
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Report -->
    <div class="card shadow-sm">

        <div class="card-header bg-light">
            <h5 class="mb-0">
                Order Report:
                @Model.FromDate.ToString("dd/MM/yyyy")
                -
                @Model.ToDate.ToString("dd/MM/yyyy")
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped table-sm">

                    <thead class="table-dark">

                        <tr>
                            <th>Ord No</th>
                            <th>Customer Name</th>

                            @foreach (var item in Model.ItemColumns)
                            {
                                <th class="text-end">
                                    @item.ItemName
                                </th>
                            }

                            <th class="text-end">Total Qty</th>
                            <th class="text-end">Amount</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Orders.Any())
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>@order.Ord_No</td>

                                    <td>@order.CustomerName</td>

                                    @foreach (var item in Model.ItemColumns)
                                    {
                                        decimal qty = 0;

                                        order.ItemQty.TryGetValue(
                                            item.ItemId,
                                            out qty
                                        );

                                        <td class="text-end">
                                            @qty.ToString("0.##")
                                        </td>
                                    }

                                    <td class="text-end fw-bold">
                                        @order.TotalQty.ToString("0.##")
                                    </td>

                                    <td class="text-end">
                                        @order.TotalAmount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model.ItemColumns.Count + 4)"
                                    class="text-center text-danger">
                                    No orders found for selected dates.
                                </td>
                            </tr>
                        }

                    </tbody>

                    @if (Model.Orders.Any())
                    {
                        <tfoot class="table-secondary fw-bold">

                            <tr>
                                <td colspan="2">
                                    GRAND TOTAL
                                </td>

                                @foreach (var item in Model.ItemColumns)
                                {
                                    <td class="text-end">
                                        @item.TotalQty.ToString("0.##")
                                    </td>
                                }

                                <td class="text-end">
                                    @Model.GrandTotalQty.ToString("0.##")
                                </td>

                                <td class="text-end">
                                    @Model.GrandTotalAmount.ToString("N2")
                                </td>
                            </tr>

                        </tfoot>
                    }

                </table>

            </div>

            <div class="row mt-3">

                <div class="col-md-6">
                    <h5>
                        Total Quantity:
                        @Model.GrandTotalQty.ToString("0.##")
                    </h5>
                </div>

                <div class="col-md-6 text-md-end">
                    <h5>
                        Grand Total Amount:
                        @Model.GrandTotalAmount.ToString("N2")
                    </h5>
                </div>

            </div>

        </div>
    </div>

</div>
