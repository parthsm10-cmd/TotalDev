@model TotalDev.Models.CreateOrderViewModel
@using TotalDev.Models
@using Microsoft.AspNetCore.Http
@using System.Globalization

@{
    ViewData["Title"] = "Create Order";

    var customers = ViewBag.Customers as List<Customer> ?? new List<Customer>();
    var products = ViewBag.Products as List<Product> ?? new List<Product>();

    var userRole = Context.Session.GetString("UserRole") ?? "";

    bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
    bool isCustomer = string.Equals(userRole, "Customer", StringComparison.OrdinalIgnoreCase);

    var currentCustomer = customers.FirstOrDefault(c => c.Id == Model.CustomerId);
}

<style>
    .order-page {
        background: #f8fafc;
        min-height: 100%;
        padding: 15px 0;
        color: #0f172a;
        font-size: 13px;
    }

    .order-content {
        max-width: 1180px;
        margin: auto;
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

        .order-header h4 {
            font-size: 20px;
            font-weight: 750;
            margin: 0;
        }

    .order-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        margin-bottom: 12px;
        overflow: hidden;
    }

    .header-panel {
        padding: 13px;
    }

    .header-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .field-label {
        display: block;
        font-weight: 700;
        font-size: 12px;
        margin-bottom: 5px;
        color: #334155;
    }

    .order-page .form-control,
    .order-page .form-select {
        font-size: 13px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        min-height: 36px;
        box-shadow: none;
    }

        .order-page .form-control:focus,
        .order-page .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, .1);
        }

    .customer-display {
        background: #f1f5f9;
        padding: 9px 11px;
        border-radius: 6px;
        font-weight: 650;
        min-height: 36px;
    }

    .products-toolbar {
        padding: 12px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

        .products-toolbar strong {
            font-size: 15px;
        }

        .products-toolbar small {
            color: #64748b;
        }

    /* Desktop table */
    .table-scroll {
        width: 100%;
        overflow-x: hidden;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .product-table thead th {
            background: #f1f5f9;
            color: #475569;
            font-size: 11px;
            font-weight: 750;
            padding: 10px;
            border-bottom: 1px solid #dbe3ee;
            text-transform: uppercase;
        }

        .product-table tbody tr {
            border-bottom: 1px solid #edf2f7;
        }

            .product-table tbody tr:hover {
                background: #f8fbff;
            }

        .product-table td {
            padding: 7px 10px;
            vertical-align: middle;
            font-size: 12px;
        }

    .col-item {
        width: 40%;
    }

    .col-rate {
        width: 20%;
    }

    .col-qty {
        width: 25%;
    }

    .col-amount {
        width: 15%;
    }

    .item-name {
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .item-rate {
        font-weight: 650;
        white-space: nowrap;
    }

    .item-unit {
        color: #64748b;
        font-size: 10px;
    }

    /* Quantity buttons */
    .qty-control {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: 100%;
    }

    .qty-btn {
        width: 36px;
        height: 38px;
        min-width: 36px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #f8fafc;
        color: #1e293b;
        font-size: 21px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
    }

        .qty-btn:hover {
            background: #eff6ff;
            border-color: #93c5fd;
        }

    .qty-input {
        width: 75px;
        min-width: 0;
        max-width: 75px;
        min-height: 38px;
        margin: 0;
        text-align: center;
        font-weight: 700;
        padding: 5px 3px;
    }

    .item-amount {
        text-align: right;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Footer */
    .order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: white;
        border: 1px solid #dbe3ee;
        border-radius: 9px;
    }

    .footer-summary {
        display: flex;
        gap: 25px;
    }

    .footer-stat {
        display: flex;
        flex-direction: column;
    }

        .footer-stat small {
            color: #64748b;
            font-size: 11px;
        }

        .footer-stat strong {
            font-size: 15px;
            font-weight: 750;
        }

    .footer-total strong {
        color: #1d4ed8;
        font-size: 20px;
    }

    .footer-actions {
        display: flex;
        gap: 8px;
    }

    .btn-reset {
        min-height: 37px;
        padding: 0 14px;
        border: 1px solid #cbd5e1;
        background: white;
        border-radius: 6px;
        font-weight: 650;
    }

    .btn-submit {
        min-height: 37px;
        padding: 0 18px;
        border: none;
        border-radius: 6px;
        background: #2563eb;
        color: white;
        font-weight: 750;
    }

        .btn-submit:disabled {
            background: #94a3b8;
            cursor: not-allowed;
        }

    /* Mobile design */
    @@media (max-width: 600px) {

        .order-page {
            padding: 8px 0;
        }

        .order-content {
            padding: 0 8px;
        }

        .order-header h4 {
            font-size: 19px;
        }

        .header-panel {
            padding: 12px;
        }

        .header-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .order-page .form-control,
        .order-page .form-select {
            min-height: 42px;
            font-size: 15px;
        }

        .products-toolbar {
            padding: 12px;
        }

        .table-scroll {
            overflow: visible;
        }

        .product-table,
        .product-table tbody {
            display: block;
            width: 100%;
        }

            .product-table thead {
                display: none;
            }

            .product-table tbody tr.product-row {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                gap: 12px;
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: 10px;
                margin: 9px;
                padding: 12px;
                width: calc(100% - 18px);
                box-shadow: 0 1px 3px rgba(0,0,0,.04);
            }

            .product-table tbody td {
                display: block;
                width: 100%;
                min-width: 0;
                padding: 0;
                border: 0;
            }

                .product-table tbody td:first-child {
                    grid-column: 1 / -1;
                    padding-bottom: 8px;
                    border-bottom: 1px solid #edf2f7;
                }

        .item-name {
            font-size: 14px;
            font-weight: 750;
            color: #0f172a;
        }

        .product-table tbody td:nth-child(2)::before {
            content: "RATE";
        }

        .product-table tbody td:nth-child(3)::before {
            content: "QUANTITY";
            text-align: center;
        }

        .product-table tbody td:nth-child(4)::before {
            content: "AMOUNT";
        }

        .product-table tbody td:nth-child(2)::before,
        .product-table tbody td:nth-child(3)::before,
        .product-table tbody td:nth-child(4)::before {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: #64748b;
            margin-bottom: 5px;
        }

        .qty-control {
            justify-content: flex-end;
            gap: 4px;
        }

        .qty-btn {
            width: 32px;
            min-width: 32px;
            height: 38px;
        }

        .qty-input {
            width: 65px;
            max-width: 65px;
            min-height: 38px;
            font-size: 15px !important;
        }

        .item-amount {
            text-align: left;
            font-size: 14px !important;
        }

        .order-footer {
            flex-direction: column;
            align-items: stretch;
            padding: 12px;
            gap: 14px;
        }

        .footer-summary {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .footer-total {
            grid-column: 1 / -1;
            padding-top: 10px;
            border-top: 1px solid #e2e8f0;
        }

        .footer-stat strong {
            font-size: 16px;
        }

        .footer-total strong {
            font-size: 22px;
        }

        .footer-actions {
            display: flex;
            width: 100%;
        }

            .footer-actions button {
                flex: 1;
                min-height: 44px;
            }
    }
</style>

<div class="order-page">
    <div class="container-fluid">
        <div class="order-content">

            <div class="order-header">
                <h4>Create Order</h4>
            </div>
              @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }
            <form asp-controller="Order_HDR"
                  asp-action="@(ViewBag.IsEdit == true ? "Edit" : "Index")"
                  method="post"
                  id="orderForm">

                @Html.AntiForgeryToken()

                @if (ViewBag.IsEdit == true)
                {
                    <input type="hidden" name="ordNo" value="@ViewBag.Ord_No" />
                    <input type="hidden" name="customerId" value="@Model.CustomerId" />
                }

                <div asp-validation-summary="All"
                        class="text-danger small mb-2"></div>

                        <!-- ORDER HEADER -->
                        <section class="order-panel header-panel">

                            <div class="header-grid">

                                <div>
                                    <label asp-for="Ord_Date" class="field-label">
                                        Order Date <span class="text-danger">*</span>
                                    </label>

                                    <input asp-for="Ord_Date"
                                    type="date"
                                    class="form-control"
                                    required />

                                    <span asp-validation-for="Ord_Date"
                                    class="text-danger small"></span>
                                </div>

                                <div>
                                    <label class="field-label">
                                        Customer <span class="text-danger">*</span>
                                    </label>

                                    @if (isAdmin)
                                            {
                                                <select asp-for="CustomerId"
                                                class="form-select"
                                                id="CustomerId"
                                                required>

                                                    <option value="">Select Customer</option>

                                                    @foreach (var c in customers)
                                                        {
                                                            <option value="@c.Id">
                                                                @c.CustName
                                                            </option>
                                                        }
                                                    </select>

                                                    <span asp-validation-for="CustomerId"
                                                    class="text-danger small"></span>
                                            }
                                            else if (isCustomer)
                                            {
                                                <input asp-for="CustomerId" type="hidden" />

                                                <div class="customer-display">
                                                    @(currentCustomer?.CustName ?? "Logged-in Customer")
                                                </div>
                                            }
                                        </div>

                                    </div>
                                </section>

                                <!-- PRODUCT DETAILS -->
                                <section class="order-panel">

                                    <div class="products-toolbar">
                                        <div>
                                            <strong>Product Details</strong>
                                            <br />
                                            <small>
                                                Change quantity using + / − or type manually.
                                            </small>
                                        </div>

                                        <small>
                                            <span id="selectedProducts">0 selected</span>
                                        </small>
                                    </div>

                                    <div class="table-scroll">

                                        <table class="product-table">

                                            <thead>
                                                <tr>
                                                    <th class="col-item">Item</th>
                                                    <th class="col-rate">Rate</th>
                                                    <th class="col-qty text-center">Qty</th>
                                                    <th class="col-amount text-end">Amount</th>
                                                </tr>
                                            </thead>

                                            <tbody id="productList">

                                                @for (int i = 0; i < products.Count; i++)
                                                {
                                                    var p = products[i];

                                                    var savedItem = Model.Items?
                                                        .FirstOrDefault(x =>
                                                            x.ItemId == p.Id.ToString());

                                                    int savedQty = Math.Max(
                                                        0, (int)(savedItem?.Qty ?? 0m));

                                                    <tr class="product-row"
                                                    data-rate="@p.MRP.ToString(CultureInfo.InvariantCulture)">

                                                        <td>
                                                            <span class="item-name">
                                                                @p.ItemName
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <div class="item-rate">
                                                                ₹@p.MRP.ToString("N2")
                                                            </div>

                                                            <span class="item-unit">
                                                                / @p.Unit
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <div class="qty-control">

                                                                <button type="button"
                                                                class="qty-btn qty-minus"
                                                                aria-label="Decrease quantity">
                                                                    −
                                                                </button>

                                                                <input type="text"
                                                                inputmode="numeric"
                                                                pattern="[0-9]*"
                                                                autocomplete="off"
                                                                class="form-control qty-input item-qty"
                                                                name="Items[@i].Qty"
                                                                value="@savedQty"
                                                                aria-label="Quantity for @p.ItemName" />

                                                                <button type="button"
                                                                class="qty-btn qty-plus"
                                                                aria-label="Increase quantity">
                                                                    +
                                                                </button>

                                                            </div>
                                                        </td>

                                                        <td class="item-amount">
                                                            ₹0.00
                                                        </td>

                                                        <input type="hidden"
                                                        name="Items[@i].ItemId"
                                                        value="@p.Id" />

                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                    </div>

                                    @if (products.Count == 0)
                                    {
                                        <div class="alert alert-warning m-3">
                                            No products available.
                                        </div>
                                    }

                                    <div class="p-2 text-end border-top">
                                        <button type="button"
                                        id="clearQuantities"
                                        class="btn btn-sm btn-outline-secondary">
                                            Clear Quantities
                                        </button>
                                    </div>

                                </section>

                                <!-- ORDER SUMMARY -->
                                <div class="order-footer">

                                    <div class="footer-summary">

                                        <div class="footer-stat">
                                            <small>Total Quantity</small>
                                            <strong id="totalQty">0</strong>
                                        </div>

                                        <div class="footer-stat">
                                            <small>Selected Products</small>
                                            <strong id="selectedCount">0</strong>
                                        </div>

                                        <div class="footer-stat footer-total">
                                            <small>Grand Total</small>
                                            <strong>
                                                ₹<span id="totalAmount">0.00</span>
                                            </strong>
                                        </div>

                                    </div>

                                    <div class="footer-actions">

                                        <button type="reset" class="btn-reset">
                                            Reset
                                        </button>

                                     @*    <button type="submit"
                                        id="placeOrderBtn"
                                        class="btn-submit"
                                        disabled>
                                            Place Order · ₹<span id="footerAmount">0.00</span>
                                        </button> *@
                                        <button type="submit" class="btn btn-primary"> @(ViewBag.IsEdit == true ? "Update Order" : "Save Order")
</button>

                                    </div>

                                </div>

            </form>
                        </div>
                        </div>
                        </div>

                        @section Scripts {

                        <partial name="_ValidationScriptsPartial" />

                        <script>
                            (function () {

                            const form = document.getElementById('orderForm');

                            const productList = document.getElementById('productList');

                            const productRows =
                            Array.from(document.querySelectorAll('.product-row'));

                            const totalQtyEl =
                            document.getElementById('totalQty');

                            const totalAmountEl =
                            document.getElementById('totalAmount');

                            const footerAmountEl =
                            document.getElementById('footerAmount');

                            const selectedProductsEl =
                            document.getElementById('selectedProducts');

                            const selectedCountEl =
                            document.getElementById('selectedCount');

                            const submitBtn =
                            document.getElementById('placeOrderBtn');

                            const customerEl =
                            document.getElementById('CustomerId');

                            // INTEGER ONLY QUANTITY
                            function getQuantity(input) {

                            const digits = input.value.replace(/[^0-9]/g, '');

                            if (input.value !== digits) {
                            input.value = digits;
                            }

                            const value = parseInt(digits, 10);

                            return Number.isFinite(value) ? value : 0;
                            }

                            // CALCULATE TOTALS
                            function recalculate() {

                            let totalQty = 0;
                            let totalAmount = 0;
                            let selected = 0;

                            productRows.forEach(function (row) {

                            const qtyInput = row.querySelector('.item-qty');

                            const qty = getQuantity(qtyInput);

                            const rate = Number(row.dataset.rate) || 0;

                            const amount = qty * rate;

                            row.querySelector('.item-amount').textContent =
                            '₹' + amount.toFixed(2);

                            totalQty += qty;
                            totalAmount += amount;

                            if (qty > 0) {
                            selected++;
                            }
                            });

                            totalQtyEl.textContent = totalQty.toString();

                            totalAmountEl.textContent = totalAmount.toFixed(2);

                            footerAmountEl.textContent = totalAmount.toFixed(2);

                            selectedProductsEl.textContent =
                            selected + ' selected';

                            selectedCountEl.textContent = selected;

                            submitBtn.disabled = selected === 0;
                            }

                            // MANUAL TYPING
                            productList.addEventListener('input', function (event) {

                            if (event.target.classList.contains('item-qty')) {

                            getQuantity(event.target);

                            recalculate();
                            }
                            });

                            // PLUS / MINUS BUTTONS
                            productList.addEventListener('click', function (event) {

                            const button = event.target.closest('.qty-btn');

                            if (!button) return;

                            const row = button.closest('.product-row');

                            const qtyInput = row.querySelector('.item-qty');

                            let qty = getQuantity(qtyInput);

                            if (button.classList.contains('qty-plus')) {
                            qty++;
                            }
                            else if (button.classList.contains('qty-minus')) {
                            qty = Math.max(0, qty - 1);
                            }

                            qtyInput.value = qty.toString();

                            recalculate();
                            });

                            // CLEAR QUANTITIES
                            document.getElementById('clearQuantities')
                            .addEventListener('click', function () {

                            productRows.forEach(function (row) {
                            row.querySelector('.item-qty').value = '0';
                            });

                            recalculate();
                            });

                            // RESET FORM
                            form.addEventListener('reset', function () {

                            setTimeout(function () {
                            recalculate();
                            }, 0);
                            });

                            // FORM SUBMISSION
                            form.addEventListener('submit', function (event) {

                            if (customerEl && !customerEl.value) {

                            event.preventDefault();

                            customerEl.focus();

                            alert('Please select a customer.');

                            return;
                            }

                            // Final integer validation
                            productRows.forEach(function (row) {

                            const input = row.querySelector('.item-qty');

                            input.value = getQuantity(input).toString();
                            });

                            const hasItems = productRows.some(function (row) {

                            return getQuantity(
                            row.querySelector('.item-qty')
                            ) > 0;
                            });

                            if (!hasItems) {

                            event.preventDefault();

                            alert(
                            'Please enter quantity for at least one product.'
                            );

                            return;
                            }

                            if (!form.checkValidity()) {

                            event.preventDefault();

                            form.reportValidity();
                            }
                            });

                            // INITIAL CALCULATION
                            recalculate();

                            })();
                        </script>
}
            
