
@model TotalDev.Models.CreateOrderViewModel
@using TotalDev.Models
@using Microsoft.AspNetCore.Http
@using System.Globalization

@{
    ViewData["Title"] = "Create Order";

    var customers = ViewBag.Customers as List<Customer>
                    ?? new List<Customer>();

    var products = ViewBag.Products as List<Product>
                   ?? new List<Product>();

    var userRole = Context.Session.GetString("UserRole") ?? "";

    bool isAdmin = string.Equals(
        userRole, "Admin", StringComparison.OrdinalIgnoreCase);

    bool isCustomer = string.Equals(
        userRole, "Customer", StringComparison.OrdinalIgnoreCase);

    var currentCustomer = customers.FirstOrDefault(
        c => c.Id.ToString() == Model.CustomerId);
}

<style>
    .order-page {
        background: #f8fafc;
        min-height: 100%;
        padding: 15px 0;
        color: #0f172a;
        font-size: 13px;
    }

    .order-content {
        max-width: 1180px;
        margin: auto;
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .order-header h4 {
        font-size: 20px;
        font-weight: 750;
        margin: 0;
    }

    .order-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        margin-bottom: 12px;
        overflow: hidden;
    }

    .header-panel {
        padding: 13px;
    }

    .header-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .field-label {
        display: block;
        font-weight: 700;
        font-size: 12px;
        margin-bottom: 5px;
        color: #334155;
    }

    .order-page .form-control,
    .order-page .form-select {
        font-size: 13px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        min-height: 36px;
        box-shadow: none;
    }

    .order-page .form-control:focus,
    .order-page .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 2px rgba(37, 99, 235, .1);
    }

    .customer-display {
        background: #f1f5f9;
        padding: 9px 11px;
        border-radius: 6px;
        font-weight: 650;
        min-height: 36px;
    }

    .products-toolbar {
        padding: 12px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .products-toolbar strong {
        font-size: 15px;
    }

    .products-toolbar small {
        color: #64748b;
    }

    .table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .product-table thead th {
        background: #f1f5f9;
        color: #475569;
        font-size: 11px;
        font-weight: 750;
        padding: 10px;
        border-bottom: 1px solid #dbe3ee;
        text-transform: uppercase;
    }

    .product-table tbody tr {
        border-bottom: 1px solid #edf2f7;
    }

    .product-table tbody tr:hover {
        background: #f8fbff;
    }

    .product-table td {
        padding: 7px 10px;
        vertical-align: middle;
        font-size: 12px;
    }

    .col-item { width: 45%; }
    .col-rate { width: 20%; }
    .col-qty { width: 15%; }
    .col-amount { width: 20%; }

    .item-name {
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .item-rate {
        font-weight: 650;
        white-space: nowrap;
    }

    .item-unit {
        color: #64748b;
        font-size: 10px;
    }

    .qty-input {
        max-width: 90px;
        margin: auto;
        text-align: center;
        font-weight: 600;
    }

    .item-amount {
        text-align: right;
        font-weight: 700;
        white-space: nowrap;
    }

    .order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: white;
        border: 1px solid #dbe3ee;
        border-radius: 9px;
    }

    .footer-summary {
        display: flex;
        gap: 25px;
    }

    .footer-stat {
        display: flex;
        flex-direction: column;
    }

    .footer-stat small {
        color: #64748b;
        font-size: 11px;
    }

    .footer-stat strong {
        font-size: 15px;
        font-weight: 750;
    }

    .footer-total strong {
        color: #1d4ed8;
        font-size: 20px;
    }

    .footer-actions {
        display: flex;
        gap: 8px;
    }

    .btn-reset {
        min-height: 37px;
        padding: 0 14px;
        border: 1px solid #cbd5e1;
        background: white;
        border-radius: 6px;
        font-weight: 650;
    }

    .btn-submit {
        min-height: 37px;
        padding: 0 18px;
        border: none;
        border-radius: 6px;
        background: #2563eb;
        color: white;
        font-weight: 750;
    }

    .btn-submit:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    @@media(max-width: 600px) {
        .header-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .order-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .footer-summary {
            justify-content: space-between;
        }

        .footer-actions button {
            flex: 1;
        }

        .product-table {
            min-width: 550px;
        }
    }
</style>

<div class="order-page">
    <div class="container-fluid">
        <div class="order-content">

            <!-- PAGE HEADER -->
            <div class="order-header">
                <h4>Create Order</h4>
            </div>

            <!-- SUCCESS MESSAGE -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- ORDER FORM -->
            <form asp-controller="Order_HDR"
                  asp-action="Index"
                  method="post"
                  id="orderForm">

                @Html.AntiForgeryToken()

                <!-- VALIDATION -->
                <div asp-validation-summary="All"
                     class="text-danger small mb-2"></div>

                <!-- HEADER DETAILS -->
                <section class="order-panel header-panel">

                    <div class="header-grid">

                        <!-- ORDER DATE -->
                        <div>
                            <label asp-for="Ord_Date"
                                   class="field-label">
                                Order Date <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Ord_Date"
                                   type="date"
                                   class="form-control"
                                   required />

                            <span asp-validation-for="Ord_Date"
                                  class="text-danger small"></span>
                        </div>

                        <!-- CUSTOMER -->
                        <div>
                            <label class="field-label">
                                Customer <span class="text-danger">*</span>
                            </label>

                            @if (isAdmin)
                            {
                                <!-- ADMIN: CUSTOMER DROPDOWN -->
                                <select asp-for="CustomerId"
                                        class="form-select"
                                        id="CustomerId"
                                        required>

                                    <option value="">
                                        Select Customer
                                    </option>

                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">
                                            @c.CustName
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="CustomerId"
                                      class="text-danger small"></span>
                            }
                            else if (isCustomer)
                            {
                                <!-- CUSTOMER: AUTOMATIC CUSTOMER ID -->
                                <input asp-for="CustomerId"
                                       type="hidden" />

                                <div class="customer-display">
                                    @(currentCustomer?.CustName ?? "Logged-in Customer")
                                </div>
                            }
                        </div>

                    </div>
                </section>

                <!-- PRODUCT DETAILS -->
                <section class="order-panel">

                    <div class="products-toolbar">
                        <div>
                            <strong>Product Details</strong>
                            <br />
                            <small>
                                Enter quantity for the products you want to order.
                            </small>
                        </div>

                        <small>
                            <span id="selectedProducts">0 selected</span>
                        </small>
                    </div>

                    <div class="table-scroll">

                        <table class="product-table">

                            <thead>
                                <tr>
                                    <th class="col-item">Item</th>
                                    <th class="col-rate">Rate</th>
                                    <th class="col-qty text-center">Qty</th>
                                    <th class="col-amount text-end">Amount</th>
                                </tr>
                            </thead>

                            <tbody id="productList">

                                @for (int i = 0; i < products.Count; i++)
                                {
                                    var p = products[i];

                                    var savedItem = Model.Items?
                                        .FirstOrDefault(x =>
                                            x.ItemId == p.Id.ToString());

                                    decimal savedQty = savedItem?.Qty ?? 0m;

                                    <tr class="product-row"
                                        data-rate="@p.MRP.ToString(CultureInfo.InvariantCulture)">

                                        <td>
                                            <span class="item-name">
                                                @p.ItemName
                                            </span>
                                        </td>

                                        <td>
                                            <div class="item-rate">
                                                ₹@p.MRP.ToString("N2")
                                            </div>

                                            <span class="item-unit">
                                                / @p.Unit
                                            </span>
                                        </td>

                                        <td>
                                            <input type="number"
                                                   step="0.001"
                                                   min="0"
                                                   class="form-control qty-input item-qty"
                                                   name="Items[@i].Qty"
                                                   value="@savedQty.ToString(CultureInfo.InvariantCulture)"
                                                   inputmode="decimal"
                                                   aria-label="Quantity for @p.ItemName" />
                                        </td>

                                        <td class="item-amount">
                                            ₹0.00
                                        </td>

                                        <!-- PRODUCT ID FOR MODEL BINDING -->
                                        <input type="hidden"
                                               name="Items[@i].ItemId"
                                               value="@p.Id" />

                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>

                    @if (products.Count == 0)
                    {
                        <div class="alert alert-warning m-3">
                            No products available.
                        </div>
                    }

                    <div class="p-2 text-end border-top">
                        <button type="button"
                                id="clearQuantities"
                                class="btn btn-sm btn-outline-secondary">
                            Clear Quantities
                        </button>
                    </div>

                </section>

                <!-- ORDER SUMMARY -->
                <div class="order-footer">

                    <div class="footer-summary">

                        <div class="footer-stat">
                            <small>Total Quantity</small>
                            <strong id="totalQty">0.000</strong>
                        </div>

                        <div class="footer-stat">
                            <small>Selected Products</small>
                            <strong id="selectedCount">0</strong>
                        </div>

                        <div class="footer-stat footer-total">
                            <small>Grand Total</small>
                            <strong>
                                ₹<span id="totalAmount">0.00</span>
                            </strong>
                        </div>

                    </div>

                    <div class="footer-actions">

                        <button type="reset"
                                class="btn-reset">
                            Reset
                        </button>

                        <button type="submit"
                                id="placeOrderBtn"
                                class="btn-submit"
                                disabled>
                            Place Order · ₹<span id="footerAmount">0.00</span>
                        </button>

                    </div>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {

            const form = document.getElementById('orderForm');

            const productRows =
                Array.from(document.querySelectorAll('.product-row'));

            const totalQtyEl =
                document.getElementById('totalQty');

            const totalAmountEl =
                document.getElementById('totalAmount');

            const footerAmountEl =
                document.getElementById('footerAmount');

            const selectedProductsEl =
                document.getElementById('selectedProducts');

            const selectedCountEl =
                document.getElementById('selectedCount');

            const submitBtn =
                document.getElementById('placeOrderBtn');

            const customerEl =
                document.getElementById('CustomerId');

            function recalculate() {

                let totalQty = 0;
                let totalAmount = 0;
                let selected = 0;

                productRows.forEach(function (row) {

                    const qtyInput =
                        row.querySelector('.item-qty');

                    const qty =
                        Math.max(0, Number(qtyInput.value) || 0);

                    const rate =
                        Number(row.dataset.rate) || 0;

                    const amount = qty * rate;

                    row.querySelector('.item-amount').textContent =
                        '₹' + amount.toFixed(2);

                    totalQty += qty;
                    totalAmount += amount;

                    if (qty > 0) {
                        selected++;
                    }

                });

                totalQtyEl.textContent = totalQty.toFixed(3);

                totalAmountEl.textContent =
                    totalAmount.toFixed(2);

                footerAmountEl.textContent =
                    totalAmount.toFixed(2);

                selectedProductsEl.textContent =
                    selected + ' selected';

                selectedCountEl.textContent = selected;

                submitBtn.disabled = selected === 0;
            }

            // QUANTITY CHANGE
            document.getElementById('productList')
                .addEventListener('input', function (event) {

                    if (event.target.classList.contains('item-qty')) {
                        recalculate();
                    }

                });

            // CLEAR QUANTITIES
            document.getElementById('clearQuantities')
                .addEventListener('click', function () {

                    productRows.forEach(function (row) {
                        row.querySelector('.item-qty').value = 0;
                    });

                    recalculate();
                });

            // RESET FORM
            form.addEventListener('reset', function () {

                setTimeout(function () {
                    recalculate();
                }, 0);

            });

            // FORM SUBMISSION VALIDATION
            form.addEventListener('submit', function (event) {

                if (customerEl && !customerEl.value) {

                    event.preventDefault();

                    customerEl.focus();

                    alert('Please select a customer.');

                    return;
                }

                const hasItems = productRows.some(function (row) {

                    return Number(
                        row.querySelector('.item-qty').value
                    ) > 0;

                });

                if (!hasItems) {

                    event.preventDefault();

                    alert(
                        'Please enter quantity for at least one product.'
                    );

                    return;
                }

                if (!form.checkValidity()) {

                    event.preventDefault();

                    form.reportValidity();
                }

            });

            // INITIAL CALCULATION
            recalculate();

        })();
    </script>
}
