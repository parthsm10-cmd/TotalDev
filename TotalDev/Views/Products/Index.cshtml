@model List<TotalDev.Models.Product>
@using TotalDev.Models

@{
    ViewData["Title"] = "Product Management";

    var editProduct = ViewBag.FormProduct as Product
        ?? ViewBag.EditProduct as Product;

    var isEdit = !string.IsNullOrWhiteSpace(editProduct?.Id);
}

<div class="container mt-4">
    <h2>Product Management</h2>

    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="card mb-4">
        <div class="card-header">
            @(isEdit ? "Update Product" : "Add Product")
        </div>

        <div class="card-body">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="Id"
                       value="@editProduct?.Id" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Item Code</label>
                        <input name="ItemCode"
                               class="form-control"
                               maxlength="30"
                               required
                               value="@editProduct?.ItemCode" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Item Name</label>
                        <input name="ItemName"
                               class="form-control"
                               maxlength="100"
                               required
                               value="@editProduct?.ItemName" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Unit</label>
                        <select name="Unit" class="form-select" required>
                            <option value="">Select Unit</option>
                            @foreach (var unit in new[]
                            {
                                "Piece", "Packet", "Kg", "Gram",
                                "Litre", "ML", "Dozen"
                            })
                            {
                                if (editProduct?.Unit == unit)
                                {
                                    <option value="@unit" selected>
                                        @unit
                                    </option>
                                }
                                else
                                {
                                    <option value="@unit">@unit</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Qty</label>
                        <input name="Qty" type="number"
                               step="0.001" min="0"
                               class="form-control" required
                               value="@(editProduct?.Qty.ToString(
                                                                  System.Globalization.CultureInfo.InvariantCulture)
                                                                  ?? "0")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">MRP (₹)</label>
                        <input name="MRP" type="number"
                               step="0.01" min="0"
                               class="form-control" required
                               value="@(editProduct?.MRP.ToString(
                                                                  System.Globalization.CultureInfo.InvariantCulture)
                                                                  ?? "0")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Remarks</label>
                        <input name="Remarks"
                               class="form-control"
                               maxlength="500"
                               value="@editProduct?.Remarks" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit"
                            class="btn btn-primary">
                        @(isEdit ? "Update Product" : "Save Product")
                    </button>

                    @if (isEdit)
                    {
                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <button type="reset"
                                class="btn btn-secondary">
                            Clear
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>

    <h4>Product List</h4>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Item Code</th>
                    <th>Item Name</th>
                    <th>Unit</th>
                    <th>Qty</th>
                    <th>MRP</th>
                    <th>Remarks</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>@item.Unit</td>
                        <td>@item.Qty</td>
                        <td>₹@item.MRP.ToString("0.00")</td>
                        <td>@item.Remarks</td>
                        <td>
                            <a asp-action="Index"
                               asp-route-editId="@item.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete this product?');">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
