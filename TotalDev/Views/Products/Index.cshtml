@model List<TotalDev.Models.Product>
@using TotalDev.Models
@using System.Globalization

@{
    ViewData["Title"] = "Product Management";

    var editProduct = ViewBag.FormProduct as Product
        ?? ViewBag.EditProduct as Product;

    var isEdit = !string.IsNullOrWhiteSpace(editProduct?.Id);
}

<style>
    .product-page {
        padding: 28px 0 40px;
        color: var(--pd-text);
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .page-heading h2 {
            font-size: 27px;
            font-weight: 750;
            margin: 0 0 5px;
            color: var(--pd-dark-green);
        }

        .page-heading p {
            color: #778279;
            margin: 0;
            font-size: 14px;
        }

    .product-count {
        background: var(--pd-light-green);
        color: var(--pd-green);
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 650;
        white-space: nowrap;
    }

    .product-card {
        background: #fff;
        border: 1px solid var(--pd-border);
        border-radius: 13px;
        overflow: hidden;
        margin-bottom: 28px;
        box-shadow: 0 4px 15px rgba(20, 83, 45, .045);
    }

    .product-card-header {
        background: #f5f9f5;
        padding: 17px 22px;
        border-bottom: 1px solid #e3eae4;
    }

        .product-card-header h4 {
            color: var(--pd-dark-green);
            font-size: 17px;
            font-weight: 700;
            margin: 0;
        }

    .product-card-body {
        padding: 23px;
    }

    .product-page .form-label {
        color: #405047;
        font-size: 13px;
        font-weight: 650;
        margin-bottom: 7px;
    }

    .product-page .form-control,
    .product-page .form-select {
        min-height: 43px;
        border-color: #dce5dd;
        border-radius: 7px;
        font-size: 14px;
    }

        .product-page .form-control:focus,
        .product-page .form-select:focus {
            border-color: var(--pd-dark-green);
            box-shadow: 0 0 0 3px rgba(20, 83, 45, .10);
        }

    .btn-pd {
        background: var(--pd-green);
        color: #fff;
        border: 1px solid var(--pd-green);
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 650;
    }

        .btn-pd:hover {
            background: var(--pd-dark-green);
            color: #fff;
        }

    .btn-light-pd {
        background: #fff;
        color: #405047;
        border: 1px solid #dce5dd;
        border-radius: 7px;
        padding: 10px 17px;
    }

        .btn-light-pd:hover {
            background: #f3f7f3;
        }

    .list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 15px;
    }

        .list-header h4 {
            color: var(--pd-dark-green);
            font-size: 19px;
            font-weight: 750;
            margin: 0;
        }

    .search-box {
        max-width: 300px;
        width: 100%;
    }

        .search-box input {
            border-radius: 8px;
            min-height: 41px;
        }

    .table-shell {
        border: 1px solid var(--pd-border);
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 15px rgba(20, 83, 45, .035);
    }

    .product-table {
        margin: 0;
        font-size: 13px;
        vertical-align: middle;
    }

        .product-table thead th {
            background: #f3f7f3;
            color: #526256;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .35px;
            white-space: nowrap;
            padding: 15px 14px;
            border-bottom: 1px solid #e0e8e1;
        }

        .product-table tbody td {
            padding: 14px;
            border-color: #edf1ed;
        }

        .product-table tbody tr:hover {
            background: #f8fbf8;
        }

    .item-code {
        color: var(--pd-green);
        font-weight: 700;
    }

    .item-name {
        font-weight: 650;
        color: #293b30;
    }

    .unit-badge {
        display: inline-block;
        background: var(--pd-light-green);
        color: var(--pd-green);
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 650;
    }

    .price-text {
        font-weight: 700;
        white-space: nowrap;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .btn-edit,
    .btn-delete {
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 650;
    }

    .btn-edit {
        background: #fff5df;
        border: 1px solid #f1dfb7;
        color: #8b6414;
    }

        .btn-edit:hover {
            background: #fbe9be;
            color: #6d4c0b;
        }

    .btn-delete {
        background: #fff0ef;
        border: 1px solid #f2d5d2;
        color: #b43c35;
    }

        .btn-delete:hover {
            background: #fbe0de;
            color: #922c27;
        }

    .empty-state {
        text-align: center;
        padding: 35px 15px !important;
        color: #7b887e;
    }

        .empty-state strong {
            display: block;
            color: #435548;
            margin-bottom: 5px;
            font-size: 15px;
        }

    @@media (max-width: 576px) {
        .product-page {
            padding-top: 18px;
        }

        .page-heading h2 {
            font-size: 23px;
        }

        .product-card-body {
            padding: 16px;
        }

        .product-card-header {
            padding: 15px 16px;
        }

        .search-box {
            max-width: none;
        }
    }
</style>

<div class="container product-page">

    <!-- Page heading -->
    <div class="page-heading">
        <div>
            <h2>Product Management</h2>
            <p>Manage your shop items, quantities and prices.</p>
        </div>

        <div class="product-count">
            Total Products: @(Model?.Count ?? 0)
        </div>
    </div>

    @* TempData messages are now shown via SweetAlert2 in the layout; removed inline alert *@

    <!-- Validation errors -->
    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <!-- Add / Update form -->
    <div class="product-card">
        <div class="product-card-header">
            <h4>@(isEdit ? "Update Product Details" : "Add New Product")</h4>
        </div>

        <div class="product-card-body">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="Id"
                       value="@editProduct?.Id" />

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label" for="ItemCode">Item Code *</label>
                        <input id="ItemCode"
                               name="ItemCode"
                               class="form-control"
                               maxlength="30"
                               placeholder="e.g. MILK001"
                               required
                               readonly
                               value="@editProduct?.ItemCode" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="ItemName">Item Name *</label>
                        <input id="ItemName"
                               name="ItemName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter item name"
                               required
                               value="@editProduct?.ItemName" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="Unit">Unit *</label>
                        <select id="Unit"
                                name="Unit"
                                class="form-select"
                                required>
                            <option value="">Select Unit</option>

                            @foreach (var unit in new[]
                            {
                                "Piece", "Packet", "Kg", "Gram",
                                "Litre", "ML", "Dozen"
                            })
                            {
                                if (editProduct?.Unit == unit)
                                {
                                    <option value="@unit" selected>@unit</option>
                                }
                                else
                                {
                                    <option value="@unit">@unit</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="Qty">Quantity *</label>
                        <input id="Qty"
                               name="Qty"
                               type="number"
                               step="0.001"
                               min="0"
                               class="form-control"
                               placeholder="Enter quantity"
                               required
                               value="@(editProduct?.Qty.ToString(CultureInfo.InvariantCulture) ?? "0")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="MRP">MRP (₹) *</label>
                        <input id="MRP"
                               name="MRP"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="Enter price"
                               required
                               value="@(editProduct?.MRP.ToString(CultureInfo.InvariantCulture) ?? "0")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="Remarks">Remarks</label>
                        <input id="Remarks"
                               name="Remarks"
                               class="form-control"
                               maxlength="500"
                               placeholder="Optional notes"
                               value="@editProduct?.Remarks" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        @* Ensure a value is always posted: hidden 0 then checkbox 1 when checked *@
                        <input type="hidden" name="IsActive" value="0" />
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="1" @(editProduct?.IsActive == 1 ? "checked" : "") />
                            <label class="form-check-label ms-2" for="IsActive">Active</label>
                        </div>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-pd">
                        @(isEdit ? "Update Product" : "Save Product")
                    </button>

                    @if (isEdit)
                    {
                        <a asp-action="Index" class="btn btn-light-pd">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <button type="reset" class="btn btn-light-pd">
                            Clear Form
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Product list -->
    <div class="list-header">
        <div>
            <h4>Product List</h4>
            <small class="text-muted">View and manage your saved items.</small>
        </div>

        <div class="search-box">
            <input type="search"
                   id="productSearch"
                   class="form-control"
                   placeholder="Search products..."
                   aria-label="Search products" />
        </div>
    </div>

    <div class="table-shell">
        <div class="table-responsive">
            <table class="table product-table" id="productTable">
                <thead>
                    <tr>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Unit</th>
                        <th>Qty</th>
                        <th>MRP</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="item-code">@item.ItemCode</span>
                                </td>

                                <td>
                                    <span class="item-name">@item.ItemName</span>
                                </td>

                                <td>
                                    <span class="unit-badge">@item.Unit</span>
                                </td>

                                <td>@item.Qty</td>

                                <td>
                                    <span class="price-text">
                                        ₹@item.MRP.ToString("0.00")
                                    </span>
                                </td>

                                <td>@item.Remarks</td>

                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Index"
                                           asp-route-editId="@item.Id"
                                           class="btn btn-edit">
                                            Edit
                                        </a>

                                        @* <form asp-action="Delete"
                                              method="post"
                                              class="d-inline swal-confirm"
                                              data-message="Are you sure you want to delete this product?">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit" class="btn btn-delete">
                                                Delete
                                            </button>
                                        </form> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <strong>No products found</strong>
                                Add your first product using the form above.
                            </td>
                        </tr>
                    }

                    <tr id="noSearchResults" style="display:none;">
                        <td colspan="7" class="empty-state">
                            <strong>No matching products</strong>
                            Try another item name or item code.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("productSearch");
            const table = document.getElementById("productTable");
            const rows = table.querySelectorAll("tbody tr:not(#noSearchResults)");
            const noResults = document.getElementById("noSearchResults");

            searchInput.addEventListener("input", function () {
                const searchText = this.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const matches = row.innerText.toLowerCase().includes(searchText);

                    row.style.display = matches ? "" : "none";

                    if (matches) {
                        visibleCount++;
                    }
                });

                noResults.style.display =
                    visibleCount === 0 && searchText !== "" ? "" : "none";
            });
        });
    </script>
}
