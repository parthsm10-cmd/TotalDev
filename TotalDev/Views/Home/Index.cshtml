@model List<TotalDev.Models.Order_HDR>
@{
    ViewData["Title"] = "Home";
}

<div class="pd-page-heading">
    <h1>Welcome to Patel Dairy</h1>
    <p>Manage your dairy products and shop information from here.</p>
    <small class="text-muted">Recent customer orders are shown below.</small>
</div>

 @if (Model != null && Model.Count > 0)
{
    <div class="table-shell mt-3">
        <div class="table-responsive">
            <table class="table product-table">
                <thead>
                    <tr>
                        <th>Order Date</th>
                        <th>Customer</th>
                        <th>Total Qty</th>
                        <th>Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Take(10))
                    {
                        <tr>
                            <td>@o.Ord_Date.ToString("g")</td>
                            <td>@(o.Customer?.CustName ?? "-")</td>
                            <td>@o.TotalQty</td>
                            <td>₹@o.TotalAmount.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="mt-3 text-muted">No recent orders.</div>
}
 
