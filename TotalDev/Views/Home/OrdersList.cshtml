
@model List<TotalDev.Models.Order_HDR>

@{
    ViewData["Title"] = "Orders";
}

<div class="pd-page-heading">
    <h1>Customer Orders</h1>
    <p>List of orders placed by customers.</p>
</div>

<div class="table-shell">
    <div class="table-responsive">
        <table class="table product-table">
            <thead>
                <tr>
                    <th>Order No</th>
                    <th>Order Date</th>
                    <th>Customer</th>
                    <th>Total Qty</th>
                    <th>Total Amount</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            <td>@(int.Parse(order.Ord_No.ToString() ?? "0"))</td>

                            <td>
                                @order.Ord_Date.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(order.CustomerId != 0 ? order.CustomerId.ToString() : "-")
                            </td>

                            <td>
                                @order.TotalQty
                            </td>

                            <td>
                                ₹@order.TotalAmount.ToString("0.00")
                            </td>

                            <td>
                                <a asp-controller="Order_HDR"
                                   asp-action="Details"
                                   asp-route-id="@order.Ord_No"
                                   class="btn btn-sm btn-primary">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No orders found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
